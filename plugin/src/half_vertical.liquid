{% assign show_details = true %}
{% if trmnl.plugin_settings.custom_fields_values.show_details == "no" %}
{% assign show_details = false %}
{% endif %}

<div class="layout layout--row layout--top layout--stretch-x">
  <div class="column w--full" data-list-limit="true" data-list-hidden-count="true">
    <div class="label label--underline mb--2 lg:mb--4 lg:label--large">Reminders</div>
    {% assign shown = false %}

    {% if reminders %}
      {% for item in reminders %}
        {% assign keep = true %}
        {% if window_mode != "all" and item.due_ts %}
          {% assign item_ts = item.due_ts | plus: 0 %}
          {% if item_ts > 0 %}{% if item_ts < window_start or item_ts > window_end %}{% assign keep = false %}{% endif %}{% endif %}
        {% endif %}
        {% if keep %}
          {% render "reminder_v2_item", item: item, show_details: show_details %}
          {% assign shown = true %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% unless reminders %}
      {% assign legacy_present = false %}
      {% if overdue.name or overdue.title or overdue.n %}
        {% assign item = overdue %}
        {% assign keep = true %}
        {% if window_mode != "all" and item.due_ts %}
          {% assign item_ts = item.due_ts | plus: 0 %}
          {% if item_ts > 0 %}{% if item_ts < window_start or item_ts > window_end %}{% assign keep = false %}{% endif %}{% endif %}
        {% endif %}
        {% if keep %}
          {% render "reminder_legacy_item", item: item, show_details: show_details %}
          {% assign shown = true %}
          {% assign legacy_present = true %}
        {% endif %}
      {% else %}
        {% for item in overdue %}
          {% assign keep = true %}
          {% if window_mode != "all" and item.due_ts %}
            {% assign item_ts = item.due_ts | plus: 0 %}
            {% if item_ts > 0 %}{% if item_ts < window_start or item_ts > window_end %}{% assign keep = false %}{% endif %}{% endif %}
          {% endif %}
          {% if keep %}
            {% render "reminder_legacy_item", item: item, show_details: show_details %}
            {% assign shown = true %}
            {% assign legacy_present = true %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if today.name or today.title or today.n %}
        {% assign item = today %}
        {% assign keep = true %}
        {% if window_mode != "all" and item.due_ts %}
          {% assign item_ts = item.due_ts | plus: 0 %}
          {% if item_ts > 0 %}{% if item_ts < window_start or item_ts > window_end %}{% assign keep = false %}{% endif %}{% endif %}
        {% endif %}
        {% if keep %}
          {% render "reminder_legacy_item", item: item, show_details: show_details %}
          {% assign shown = true %}
          {% assign legacy_present = true %}
        {% endif %}
      {% else %}
        {% for item in today %}
          {% assign keep = true %}
          {% if window_mode != "all" and item.due_ts %}
            {% assign item_ts = item.due_ts | plus: 0 %}
            {% if item_ts > 0 %}{% if item_ts < window_start or item_ts > window_end %}{% assign keep = false %}{% endif %}{% endif %}
          {% endif %}
          {% if keep %}
            {% render "reminder_legacy_item", item: item, show_details: show_details %}
            {% assign shown = true %}
            {% assign legacy_present = true %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endunless %}

    {% unless shown %}
      {% if window_mode == "all" %}
        <span class="description lg:description--large">No reminders due.</span>
      {% else %}
        <span class="description lg:description--large">Nothing due in this window.</span>
      {% endif %}
    {% endunless %}
  </div>
</div>

{% render "title_bar" %}
