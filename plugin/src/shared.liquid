{% assign show_details = true %}
{% if trmnl.plugin_settings.custom_fields_values.show_details == "no" %}
{% assign show_details = false %}
{% endif %}

{# TRMNL Companion "Send Data to Plugin" nests the payload under a key (default
   "data"). Normalize both shapes: Companion's {"data": {reminders|today|...}}
   and the macOS sender's top-level {reminders|today|future|overdue}. #}
{% if data %}
  {% if data.reminders %}{% assign reminders = data.reminders %}{% endif %}
  {% if data.today %}{% assign today = data.today %}{% endif %}
  {% if data.future %}{% assign future = data.future %}{% endif %}
  {% if data.overdue %}{% assign overdue = data.overdue %}{% endif %}
{% endif %}

{% if trmnl.plugin_settings.custom_fields_values.due_window == "week" %}{% assign window_mode = "week" %}
{% elsif trmnl.plugin_settings.custom_fields_values.due_window == "month" %}{% assign window_mode = "month" %}
{% elsif trmnl.plugin_settings.custom_fields_values.due_window == "year" %}{% assign window_mode = "year" %}
{% else %}{% assign window_mode = "all" %}
{% endif %}

{% assign now_ts = trmnl.user.timestamp | default: 0 | plus: 0 %}
{% if now_ts <= 0 %}
{% assign now_ts = "now" | date: "%s" | plus: 0 %}
{% endif %}
{% if now_ts <= 0 %}
{% assign window_mode = "all" %}
{% endif %}

{% assign window_start = 0 %}
{% assign window_end = 999999999999 %}
{% if window_mode == "week" %}
{% assign window_start = now_ts | minus: 604800 %}
{% assign window_end = now_ts | plus: 604800 %}
{% elsif window_mode == "month" %}
{% assign window_start = now_ts | minus: 2678400 %}
{% assign window_end = now_ts | plus: 2678400 %}
{% elsif window_mode == "year" %}
{% assign window_start = now_ts | minus: 31536000 %}
{% assign window_end = now_ts | plus: 31536000 %}
{% endif %}

{% template reminder_legacy_item %}
{% assign title = item.name | default: item.title | default: item.n %}
{% assign date = item.deadline | default: item.date | default: item.d %}
{% assign priority = item.priority | default: item.p %}
{% assign flagged = item.flagged | default: item.f %}
{% assign list = item.list | default: item.list_name | default: item.l %}
{% assign notes = item.notes | default: item.description | default: item.o %}

<div class="item w--full">
  <div class="meta"></div>
  <div class="content w--full">
    <span class="title title--small lg:title--base">{% if flagged %}! {% endif %}{{ title | escape }}</span>
    {% if show_details %}
      {% if date and date != "" %}
        <span class="description lg:description--large">{{ date | escape }}</span>
      {% endif %}
      {% if priority and priority != "" and priority != "None" %}
        <span class="description lg:description--large">{{ priority | escape }}</span>
      {% endif %}
      {% if list and list != "" %}
        <span class="description lg:description--large">{{ list | escape }}</span>
      {% endif %}
      {% if notes and notes != "" %}
        <span class="description lg:description--large" data-clamp="2">{{ notes | escape }}</span>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% template reminder_v2_item %}
{% assign title = item.title | default: item.name | default: item.n %}
{% assign date = item.date | default: item.deadline | default: item.d %}
{% assign notes = item.description | default: item.notes | default: item.o %}
{% assign subtask_count = item.num_tasks | default: 0 %}

<div class="item w--full">
  <div class="meta"></div>
  <div class="content w--full">
    <span class="title title--small lg:title--base">{% if item.idx %}{{ item.idx }}. {% endif %}{{ title | escape }}</span>
    {% if show_details %}
      {% if date and date != "" %}
        <span class="description lg:description--large">{{ date | escape }}</span>
      {% endif %}
      {% if subtask_count > 0 %}
        <span class="description lg:description--large">{{ subtask_count }} subtasks</span>
      {% endif %}
      {% if notes and notes != "" %}
        <span class="description lg:description--large" data-clamp="2">{{ notes | escape }}</span>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <span class="title lg:title--large">Apple Reminders</span>
</div>
{% endtemplate %}
